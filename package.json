{
  "name": "unicornstudio",
  "version": "2.6.1",
  "description": "Official Unicorn Studio components for React, Next.js, Vue and Svelte.",
  "keywords": [
    "unicornstudio",
    "unicorn-studio",
    "webgl",
    "shader",
    "react",
    "nextjs",
    "vue",
    "svelte"
  ],
  "homepage": "https://www.unicorn.studio/docs/embed/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiunicornstudio/unicornstudio.git"
  },
  "bugs": {
    "url": "https://github.com/hiunicornstudio/unicornstudio/issues"
  },
  "license": "MIT",
  "author": "Unicorn Studio (https://www.unicorn.studio)",
  "type": "module",
  "sideEffects": [
    "./sdk/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "files": [
    "dist",
    "sdk"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/svelte dist/svelte",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-sdk": "node scripts/sync-sdk.mjs",
    "version": "npm run sync-sdk && git add sdk",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
